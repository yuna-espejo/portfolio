---
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
const a = t.about;
---

<Base lang="en" title={t.meta.aboutTitle} description={t.meta.aboutDescription}>
  <div class="about-page">
    <div class="about-inner">

      <header class="about-header">
        <span class="about-role">{a.role}</span>
        <h1 class="about-name">Yuna Espejo</h1>
        <p class="about-company">
          <span class="about-company-name">{a.company}</span>
          <span class="about-company-period">{a.companyPeriod}</span>
        </p>
        <p class="about-bio">{a.bio}</p>
      </header>

      <section class="about-section">
        <h2 class="section-label">{a.whatSetsApartHeading}</h2>
        <dl class="traits-dl">
          {a.traits.map((trait) => (
            <>
              <dt class="trait-label">{trait.label}</dt>
              <dd class="trait-text">{trait.text}</dd>
            </>
          ))}
        </dl>
      </section>

      <section class="about-section">
        <h2 class="section-label">{a.whyHeading}</h2>
        <p class="about-body">{a.why}</p>
      </section>

      <section class="about-section">
        <h2 class="section-label">{a.communityHeading}</h2>
        <ul class="community-list" role="list">
          {a.community.map((item) => (
            <li class="community-item">
              <span class="community-label">{item.label}</span>
              {item.href ? (
                <a href={item.href} class="community-text community-link" target="_blank" rel="noopener noreferrer">{item.text}</a>
              ) : (
                <span class="community-text">{item.text}</span>
              )}
            </li>
          ))}
        </ul>
      </section>

    </div>
  </div>
</Base>

<style>
  .about-page {
    padding-bottom: var(--space-20);
  }

  .about-inner {
    max-width: 1200px;
    padding-inline: clamp(24px, 5vw, 96px);
  }

  .about-header {
    padding-block: var(--space-16) var(--space-12);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-16);
  }

  .about-role {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .about-name {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-3xl), 5vw, 3rem);
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .about-company {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-6);
  }

  .about-company-name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .about-company-period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .about-bio {
    font-size: var(--text-base);
    color: var(--muted);
    line-height: 1.7;
    max-width: 70ch;
  }

  .about-section {
    border-top: 1px solid var(--line);
    padding-block: var(--space-16);
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: var(--space-8);
  }

  .about-body {
    font-size: var(--text-base);
    color: var(--muted);
    line-height: 1.7;
    max-width: 70ch;
  }

  .traits-dl {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-3) var(--space-6);
    align-items: baseline;
  }

  .trait-label {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
    padding-top: 2px;
  }

  .trait-text {
    margin: 0;
    font-size: var(--text-base);
    color: var(--muted);
    line-height: 1.7;
  }

  .community-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .community-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .community-item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .community-label {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
  }

  .community-text {
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.6;
  }

  .community-link {
    color: var(--link);
    text-decoration: none;
  }

  .community-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .traits-dl {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .trait-label {
      margin-top: var(--space-4);
    }

    .trait-label:first-child {
      margin-top: 0;
    }
  }
</style>
