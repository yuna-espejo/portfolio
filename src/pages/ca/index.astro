---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import CircuitSimulation from '../../components/CircuitSimulation.astro';
import ExperienceHighlights from '../../components/ExperienceHighlights.astro';
import StackReal from '../../components/StackReal.astro';
import EducationCerts from '../../components/EducationCerts.astro';
import OutsideCode from '../../components/OutsideCode.astro';
import ContactCta from '../../components/ContactCta.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('ca');
---

<Base lang="ca" title={t.meta.homeTitle} description={t.meta.homeDescription}>
  <Hero lang="ca" />
