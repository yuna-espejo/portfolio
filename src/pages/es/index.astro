---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Intro from '../../components/Intro.astro';
import EducationStack from '../../components/EducationStack.astro';
import ExperienceTimeline from '../../components/ExperienceTimeline.astro';
import ExperienceHighlights from '../../components/ExperienceHighlights.astro';
import CircuitSimulation from '../../components/CircuitSimulation.astro';
import OutsideCode from '../../components/OutsideCode.astro';
import ContactCta from '../../components/ContactCta.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('es');
---

<Base lang="es" title={t.meta.homeTitle} description={t.meta.homeDescription}>
  <Hero lang="es" />
  <Intro lang="es" />
  <EducationStack lang="es" />
  <ExperienceTimeline lang="es" />
  <ExperienceHighlights lang="es" />
  <div class="wrap" style="padding-bottom: 112px"><CircuitSimulation lang="es" /></div>
  <OutsideCode lang="es" />
  <ContactCta lang="es" />
</Base>
