---
import { useTranslations, type Lang } from '../i18n/utils';
import { site } from '../config/site';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<section class="hero" id="top">
  <div class="wrap hero-top">
    <svg class="hero-line" viewBox="0 0 1200 220" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 160 L340 160 C400 160 410 120 450 100 L600 40 C640 24 680 30 700 60 L760 150 C780 180 820 180 850 160 L1200 160" />
    </svg>

    <p class="hero-eyebrow">{t.home.eyebrow}</p>
    <h1 class="hero-name">Yuna Espejo</h1>

    <div class="hero-row">
      <div class="hero-photo-wrap">
        <img
          src="/foto-atardecer-2.jpg"
          alt="Yuna Espejo"
          class="hero-photo"
          width="340"
          height="420"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="hero-side">
        <span class="outline-word" aria-hidden="true">{t.home.outlineWord}</span>
        <span class="outline-word outline-word--faded" aria-hidden="true">{t.home.outlineWord}</span>
        <ul class="hero-links" role="list">
          <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn · /yuna-espejo-santana</a></li>
          <li><a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram · @yesa.exe</a></li>
          <li><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub · /yuna-espejo</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="hero-strip">
    <div class="wrap hero-strip-inner">
      <p class="hero-headline">{t.home.headline}</p>
      <a href="#hola" class="hero-scroll">
        <span>{t.home.scrollLine1}</span>
        <span>{t.home.scrollLine2}</span>
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 2 V12 M3 8 L7 12 L11 8" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--navy);
    color: var(--bg);
    position: relative;
  }

  .hero-top {
    position: relative;
    padding-top: var(--space-10);
  }

  .hero-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 140px;
    width: 100%;
    height: 220px;
    opacity: 0.5;
    pointer-events: none;
  }
  .hero-line path {
    fill: none;
    stroke: #9FB4DA;
    stroke-width: 1.5;
    stroke-dasharray: 6 8;
  }

  .hero-eyebrow {
    position: relative;
    font-size: 15px;
    font-weight: 500;
    color: var(--navy-soft);
  }

  .hero-name {
    position: relative;
    margin-top: var(--space-2);
    font-weight: 900;
    font-size: clamp(60px, 10.5vw, 160px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    color: var(--bg);
  }

  .hero-row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-10);
    margin-top: var(--space-8);
  }

  .hero-photo-wrap {
    flex: 0 0 auto;
    width: min(340px, 100%);
    height: 420px;
    margin-bottom: -140px;
    position: relative;
    z-index: 2;
    overflow: hidden;
    border-radius: 6px;
    background: var(--accent);
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .hero-side {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-bottom: var(--space-5);
  }

  .outline-word {
    font-weight: 900;
    font-size: clamp(44px, 6.5vw, 96px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--accent);
    white-space: nowrap;
  }
  .outline-word--faded { opacity: 0.55; }

  .hero-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-6);
    font-weight: 500;
  }
  .hero-links a {
    color: var(--bg);
    text-decoration: none;
  }
  .hero-links a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  /* Franja inferior */
  .hero-strip {
    background: var(--navy-deep);
    position: relative;
    z-index: 1;
  }

  .hero-strip-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: 36px;
  }

  .hero-headline {
    flex: 0 1 520px;
    font-size: 17px;
    line-height: 1.55;
    color: #E3E9F5;
  }

  .hero-scroll {
    width: 112px;
    height: 112px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--accent);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    font-size: 15px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    transition: transform var(--transition);
  }
  .hero-scroll:hover { color: var(--ink); transform: translateY(2px); }

  /* La foto sobresale sobre la franja: el texto se aparta */
  @media (min-width: 760px) {
    .hero-strip-inner { padding-left: calc(var(--wrap-pad) + 340px + var(--space-10)); }
  }

  @keyframes hero-in {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }
  .hero-eyebrow    { animation: hero-in 650ms ease both; }
  .hero-name       { animation: hero-in 700ms ease 120ms both; }
  .hero-photo-wrap { animation: hero-in 700ms ease 240ms both; }
  .hero-side       { animation: hero-in 700ms ease 360ms both; }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow, .hero-name, .hero-photo-wrap, .hero-side { animation: none; }
    .hero-scroll { transition: none; }
  }
</style>
