---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { site } from '../config/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { href: `/${lang}/experience`, label: t.nav.experience },
  { href: `/${lang}/projects`,   label: t.nav.projects },
  { href: `/${lang}/about`,      label: t.nav.about },
  { href: `/${lang}/cv`,         label: t.nav.cv },
  { href: `/${lang}/contact`,    label: t.nav.contact },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<!-- Sticky header bar -->
<header class="site-header" id="site-header">
  <div class="wrap header-inner">
    <a href={`/${lang}/`} class="logo" aria-label="Yuna Espejo — inicio">Yuna Espejo</a>

    <div class="header-controls">
      <div class="header-lang"><LanguageSwitcher /></div>
      <a href={`/${lang}/contact`} class="header-cta">{t.home.contactHeading}</a>
      <button
        class="menu-toggle"
        id="menu-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="20" height="14" viewBox="0 0 20 14" aria-hidden="true"><path d="M1 1 H19 M1 7 H19 M1 13 H19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Menú a pantalla completa -->
<div
  class="mobile-menu"
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
  aria-hidden="true"
>
  <div class="wrap mobile-menu-top">
    <a href={`/${lang}/`} class="logo" aria-label="Yuna Espejo — inicio">Yuna Espejo</a>
    <button class="menu-close" id="menu-close" type="button" aria-label="Cerrar menú">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <nav class="wrap mobile-nav" aria-label="Navegación principal">
    {links.map(({ href, label }) => {
      const isActive = currentPath === href.replace(/\/$/, '');
      return (
        <a
          href={href}
          class:list={['mobile-nav-link', { active: isActive }]}
          aria-current={isActive ? 'page' : undefined}
        >
          <span>{label}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      );
    })}
  </nav>

  <div class="wrap mobile-controls">
    <LanguageSwitcher />
    <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="mobile-social">LinkedIn</a>
    <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="mobile-social">@yesa.exe</a>
  </div>
</div>

<style>
  /* ── Cabecera ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--navy);
    color: var(--bg);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 78px;
  }

  .logo {
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -0.01em;
    color: var(--bg);
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo:hover { color: var(--bg); opacity: 0.85; }

  .header-controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .header-cta {
    height: 46px;
    padding: 0 22px;
    display: flex;
    align-items: center;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--ink);
    font-size: var(--text-base);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .header-cta:hover { color: var(--ink); opacity: 0.9; }

  .menu-toggle,
  .menu-close {
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--navy-line);
    background: transparent;
    color: var(--bg);
    cursor: pointer;
    flex-shrink: 0;
    transition: background var(--transition);
  }
  .menu-toggle:hover,
  .menu-close:hover { background: rgba(255, 255, 255, 0.08); }

  /* ── Menú a pantalla completa ── */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--navy-deep);
    color: var(--bg);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
    opacity: 0;
    transform: translateY(-12px);
    pointer-events: none;
    visibility: hidden;
    transition: opacity 250ms ease, transform 250ms ease, visibility 0s linear 250ms;
  }

  .mobile-menu[aria-hidden="false"] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
    transition: opacity 250ms ease, transform 250ms ease, visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      transition: opacity 150ms ease, visibility 0s linear 150ms;
      transform: none !important;
    }
    .mobile-menu[aria-hidden="false"] {
      transition: opacity 150ms ease, visibility 0s linear 0s;
    }
  }

  .mobile-menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 78px;
    flex-shrink: 0;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    padding-block: var(--space-6);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 20px;
    border-bottom: 1px solid #2C3A57;
    font-weight: 800;
    font-size: clamp(36px, 6vw, 64px);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--bg);
    text-decoration: none;
  }
  .mobile-nav-link .arrow { font-size: 28px; color: var(--accent); }
  .mobile-nav-link:hover,
  .mobile-nav-link.active { color: var(--accent); }

  .mobile-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    padding-block: var(--space-6) var(--space-10);
    flex-shrink: 0;
  }

  .mobile-social {
    color: #B9C6DD;
    text-decoration: none;
  }
  .mobile-social:hover { color: var(--bg); }

  @media (max-width: 639px) {
    .header-lang { display: none; }
  }

  @media (max-width: 399px) {
    .header-cta { display: none; }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menu   = document.getElementById('mobile-menu') as HTMLElement | null;
  const closeBtn = document.getElementById('menu-close') as HTMLButtonElement | null;

  function getFocusables(): HTMLElement[] {
    if (!menu) return [];
    return Array.from(
      menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
    );
  }

  function openMenu() {
    if (!menu || !toggle) return;
    menu.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Cerrar menú');
    document.body.style.overflow = 'hidden';
    // Focus the close button
    requestAnimationFrame(() => closeBtn?.focus());
  }

  function closeMenu() {
    if (!menu || !toggle) return;
    menu.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Abrir menú');
    document.body.style.overflow = '';
    toggle.focus();
  }

  toggle?.addEventListener('click', () => {
    menu?.getAttribute('aria-hidden') === 'false' ? closeMenu() : openMenu();
  });

  closeBtn?.addEventListener('click', closeMenu);

  // Close on nav link click
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));

  // Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.getAttribute('aria-hidden') === 'false') {
      closeMenu();
    }
  });

  // Focus trap
  menu?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const focusables = getFocusables();
    if (focusables.length === 0) return;
    const first = focusables[0];
    const last  = focusables[focusables.length - 1];

    if (e.shiftKey) {
      if (document.activeElement === first) {
        e.preventDefault();
        last.focus();
      }
    } else {
      if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
