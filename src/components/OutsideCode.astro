---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<section class="outside">
  <div class="outside-inner">

    <h2 class="outside-heading">{t.home.outsideHeading}</h2>

    <ul class="outside-grid" role="list">
      {t.home.outsideItems.map((item) => (
        <li class="outside-item">
          <p class="outside-label">
            {item.href ? (
              <a href={item.href} target="_blank" rel="noopener noreferrer" class="outside-label-link">
                {item.label}
                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            ) : item.label}
          </p>
          <p class="outside-text">{item.text}</p>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .outside {
    padding-block: var(--space-16);
    border-top: 1px solid var(--line);
  }

  .outside-inner {
    max-width: 900px;
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .outside-heading {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-10);
  }

  .outside-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .outside-item {
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-right: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .outside-item:last-child {
    border-right: 1px solid var(--line);
  }

  .outside-label {
    font-size: 13px;
    color: var(--ink);
    font-weight: 500;
  }

  .outside-label-link {
    color: var(--link);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .outside-label-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .outside-text {
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.65;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .outside-grid {
      grid-template-columns: 1fr;
    }

    .outside-item {
      border-right: 1px solid var(--line);
      border-top: none;
    }

    .outside-item:first-child {
      border-top: 1px solid var(--line);
    }
  }

  @media (min-width: 641px) and (max-width: 800px) {
    .outside-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .outside-item:nth-child(2) {
      border-right: 1px solid var(--line);
    }

    .outside-item:last-child {
      border-top: none;
      grid-column: 1 / -1;
      border-right: 1px solid var(--line);
    }
  }
</style>
