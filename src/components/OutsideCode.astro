---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<section class="outside">
  <div class="wrap outside-inner">

    <h2 class="outside-heading">{t.home.outsideHeading}</h2>

    <ul class="outside-grid" role="list">
      {t.home.outsideItems.map((item, index) => (
        <li class="outside-item">
          {index === 0 && (
            <svg class="icon" width="120" height="72" viewBox="0 0 120 72" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
              <path d="M36 22 H46 L51 14 H69 L74 22 H84 C88 22 90 24 90 28 V54 C90 58 88 60 84 60 H36 C32 60 30 58 30 54 V28 C30 24 32 22 36 22 Z" fill="none" stroke="var(--navy)" stroke-width="2.4" stroke-linejoin="round"/>
              <circle cx="60" cy="40" r="10" fill="none" stroke="var(--navy)" stroke-width="2.4"/>
              <circle cx="82" cy="29" r="3" fill="var(--accent)"/>
            </svg>
          )}

          {index === 1 && (
            <svg class="icon" width="120" height="72" viewBox="0 0 120 72" role="img" aria-label="Instagram" xmlns="http://www.w3.org/2000/svg">
              <rect x="42" y="4" width="36" height="64" rx="6" fill="none" stroke="var(--navy)" stroke-width="2.4"/>
              <path d="M50 30 L55 35 L50 40 M60 40 H70" fill="none" stroke="var(--navy)" stroke-width="2.4"/>
              <circle cx="60" cy="60" r="3.5" fill="var(--accent)"/>
            </svg>
          )}

          {index === 2 && (
            <svg class="icon" width="120" height="72" viewBox="0 0 120 72" role="img" aria-label="Rewriting the Code" xmlns="http://www.w3.org/2000/svg">
              <path d="M30 52 L60 16 L90 52 Z" fill="none" stroke="var(--navy)" stroke-width="2.4" stroke-linejoin="round"/>
              <circle cx="30" cy="52" r="8" fill="var(--bg)" stroke="var(--navy)" stroke-width="2.4"/>
              <circle cx="90" cy="52" r="8" fill="var(--bg)" stroke="var(--navy)" stroke-width="2.4"/>
              <circle cx="60" cy="16" r="8" fill="var(--accent)"/>
            </svg>
          )}

          <h3 class="outside-label">
            {item.href ? (
              <a
                href={item.href}
                {...(item.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >{item.label} {item.href.startsWith('http') ? '↗' : '→'}</a>
            ) : item.label}
          </h3>
          <p class="outside-text">{item.text}</p>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .outside-inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: 24px 112px;
  }

  .outside-heading {
    font-weight: 900;
    font-size: clamp(42px, 6vw, 72px);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .outside-grid {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
  }

  .outside-item {
    flex: 1 1 240px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .icon { display: block; }

  .outside-label {
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  .outside-label a {
    color: var(--ink);
    text-decoration: none;
  }
  .outside-label a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }

  .outside-text {
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
