---
import { useTranslations, type Lang } from '../i18n/utils';
import { site } from '../config/site';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<section class="contact">
  <div class="wrap contact-inner">
    <h2 class="contact-heading">{t.home.contactBigHeading}</h2>

    <div class="contact-side">
      <p class="contact-tagline">{t.home.contactTagline}</p>
      <div class="contact-actions">
        <a href={`/${Astro.props.lang}/contact`} class="cta cta-primary">{t.home.contactForm} →</a>
        <a href={"mailto:" + site.email} class="cta cta-secondary">{t.home.contactEmail}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--navy-deep);
    color: var(--bg);
  }

  .contact-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    padding-top: 88px;
    padding-bottom: 56px;
  }

  .contact-heading {
    font-weight: 900;
    font-size: clamp(56px, 9vw, 128px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    color: var(--bg);
  }

  .contact-side {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 440px;
  }

  .contact-tagline {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: #B9C6DD;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    padding: 16px 28px;
    border-radius: var(--radius-pill);
    font-size: var(--text-base);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--transition), border-color var(--transition);
  }

  .cta-primary {
    background: var(--accent);
    color: var(--ink);
  }
  .cta-primary:hover { color: var(--ink); opacity: 0.9; }

  .cta-secondary {
    border: 1.5px solid var(--navy-line);
    color: var(--bg);
  }
  .cta-secondary:hover { color: var(--bg); border-color: var(--bg); }
</style>
