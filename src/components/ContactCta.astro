---
import { useTranslations, type Lang } from '../i18n/utils';
import { site } from '../config/site';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<section class="contact">
  <div class="contact-inner">

    <h2 class="contact-heading">{t.home.contactHeading}</h2>
    <p class="contact-tagline">{t.home.contactTagline}</p>

    <div class="contact-actions">
      <a
        href={"mailto:" + site.email}
        class="cta cta-primary"
      >
        {t.home.contactEmail}
      </a>
      <a
        href={`/${Astro.props.lang}/contact`}
        class="cta cta-secondary"
      >
        {t.home.contactForm}
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

  </div>
</section>

<style>
  .contact {
    padding-block: var(--space-16);
    border-top: 1px solid var(--line);
  }

  .contact-inner {
    max-width: 1200px;
    padding-inline: clamp(24px, 5vw, 96px);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .contact-heading {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-3xl), 4vw, 2.5rem);
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .contact-tagline {
    font-size: var(--text-lg);
    color: var(--muted);
    line-height: 1.6;
    max-width: 48ch;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
    white-space: nowrap;
  }

  .cta-primary {
    background: var(--olive);
    color: var(--bg);
    border: 1px solid transparent;
  }

  .cta-primary:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .cta-secondary {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line);
  }

  .cta-secondary:hover {
    border-color: var(--muted);
    background: var(--surface);
  }
</style>
