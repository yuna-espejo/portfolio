---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);

const stack = [
  {
    key: 'integration' as const,
    items: ['SAP Integration Suite', 'SAP Cloud Integration', 'SAP BTP', 'SuccessFactors', 'SAP Plateau'],
  },
  {
    key: 'languages' as const,
    items: ['Groovy', 'SQL', 'Python', 'JavaScript'],
  },
  {
    key: 'formats' as const,
    items: ['REST', 'XML', 'XSLT', 'JSON', 'CSV', 'SFTP', 'Microsoft Graph'],
  },
  {
    key: 'devops' as const,
    items: ['GitHub Actions', 'Git', 'Bitbucket', 'Docker', 'Postman', 'Linux'],
  },
  {
    key: 'data' as const,
    items: ['PostgreSQL', 'MySQL', 'Power BI', 'Excel'],
  },
];
---

<section class="stack">
  <div class="stack-inner">

    <h2 class="stack-heading">{t.home.stackHeading}</h2>

    <dl class="stack-list">
      {stack.map((row) => (
        <>
          <dt class="stack-category">{t.home.stackCategories[row.key]}</dt>
          <dd class="stack-items">
            {row.items.map((item) => (
              <span class="stack-pill">{item}</span>
            ))}
          </dd>
        </>
      ))}
    </dl>

  </div>
</section>

<style>
  .stack {
    padding-block: var(--space-16);
    border-top: 1px solid var(--line);
  }

  .stack-inner {
    max-width: 900px;
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .stack-heading {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-10);
  }

  /* Tabla de definición */
  .stack-list {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-1) 0;
  }

  .stack-category,
  .stack-items {
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
    margin: 0;
  }

  .stack-category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-right: var(--space-6);
    align-self: start;
    padding-top: calc(var(--space-4) + 2px); /* alinear con pills */
  }

  .stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-content: flex-start;
  }

  .stack-pill {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  /* Responsive */
  @media (max-width: 600px) {
    .stack-list {
      grid-template-columns: 1fr;
    }

    .stack-category {
      border-top: 1px solid var(--line);
      padding-bottom: var(--space-2);
      padding-top: var(--space-4);
    }

    .stack-items {
      border-top: none;
      padding-top: 0;
      padding-bottom: var(--space-4);
    }

    /* La primera dt no necesita borde superior doble */
    .stack-category:first-of-type {
      margin-top: 0;
    }
  }
</style>
