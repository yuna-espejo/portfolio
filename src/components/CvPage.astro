---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import { useTranslations, type Lang } from '../i18n/utils';
import { site } from '../config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.cv;

const stack = [
  { key: 'integration' as const, items: ['SAP Integration Suite', 'SAP Cloud Integration', 'SAP BTP', 'SuccessFactors', 'SAP Plateau'] },
  { key: 'languages' as const, items: ['Groovy', 'SQL', 'Python', 'JavaScript'] },
  { key: 'formats' as const, items: ['REST', 'XML', 'XSLT', 'JSON', 'CSV', 'SFTP', 'Microsoft Graph'] },
  { key: 'devops' as const, items: ['GitHub Actions', 'Git', 'Bitbucket', 'Docker', 'Postman', 'Linux'] },
  { key: 'data' as const, items: ['PostgreSQL', 'MySQL', 'Power BI', 'Excel'] },
];
---

<Base lang={lang} title={t.meta.cvTitle} description={t.meta.cvDescription}>
  <PageHero eyebrow={t.nav.cv} title="Yuna Espejo" intro={t.about.role} outline="CV" />

  <section class="cv-actions">
    <div class="wrap cv-actions-inner">
      <a class="cv-download" href="/cv/Yuna_Espejo_Santana_CV.pdf" download>
        {c.downloadLabel}
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2 V11 M4 7.5 L8 11.5 L12 7.5 M3 14 H13" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      </a>
      <ul class="cv-links" role="list">
        <li><a href={"mailto:" + site.email}>{site.email}</a></li>
        <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></li>
        <li><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></li>
      </ul>
    </div>
  </section>

  <section class="cv-block">
    <div class="wrap cv-block-inner">
      <h2 class="cv-heading">{c.experienceHeading}</h2>
      <ul class="cv-list" role="list">
        {c.jobs.map((job) => (
          <li class="cv-item">
            <span class="cv-period">{job.period}</span>
            <div class="cv-item-body">
              <h3 class="cv-item-title">{job.title}</h3>
              <p class="cv-item-sub">{job.company} · {job.type}</p>
              <ul class="cv-bullets" role="list">
                {job.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cv-block cv-block--navy">
    <div class="wrap cv-block-inner">
      <h2 class="cv-heading">{c.educationHeading}</h2>
      <ul class="cv-list" role="list">
        {t.home.education.map((edu) => (
          <li class="cv-item">
            <span class="cv-period">{edu.period}</span>
            <div class="cv-item-body">
              <h3 class="cv-item-title">{edu.degree}</h3>
              <p class="cv-item-sub">{edu.school}{edu.spec ? ' · ' + edu.spec : ''}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cv-block">
    <div class="wrap cv-block-inner">
      <h2 class="cv-heading">{c.skillsHeading}</h2>
      <dl class="cv-stack">
        {stack.map((row) => (
          <div class="cv-stack-row">
            <dt>{t.home.stackCategories[row.key]}</dt>
            <dd>{row.items.map((item) => <span class="cv-pill">{item}</span>)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="cv-block cv-block--surface">
    <div class="wrap cv-block-inner cv-two">
      <div>
        <h2 class="cv-heading">{c.certsHeading}</h2>
        <ul class="cv-list cv-list--compact" role="list">
          {t.home.certifications.map((cert) => (
            <li class="cv-item">
              <span class="cv-period">{cert.year || 'MOS'}</span>
              <div class="cv-item-body">
                <h3 class="cv-item-title">{cert.name}</h3>
                <p class="cv-item-sub">{cert.issuer}{cert.detail ? ' · ' + cert.detail : ''}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="cv-heading">{c.languagesHeading}</h2>
        <ul class="cv-langs" role="list">
          {c.languages.map((l) => (
            <li>
              <span class="cv-lang-name">{l.lang}</span>
              <span class="cv-lang-level">{l.level}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .cv-actions-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-8);
  }

  .cv-download {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: 16px 30px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
    transition: transform 200ms ease, background 200ms ease;
  }
  .cv-download:hover { transform: translateY(-2px); background: var(--accent-ink); color: var(--bg); }

  .cv-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    font-weight: 600;
  }
  .cv-links a { color: var(--ink); text-decoration: none; border-bottom: 2px solid var(--accent); padding-bottom: 2px; }
  .cv-links a:hover { color: var(--accent-ink); }

  .cv-block-inner { padding-block: clamp(48px, 6vw, 88px); }
  .cv-block--navy { background: var(--navy); color: var(--bg); }
  .cv-block--surface { background: var(--surface); }

  .cv-heading {
    font-weight: 900;
    font-size: clamp(36px, 5vw, 64px);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: var(--space-8);
  }
  .cv-block--navy .cv-heading { color: var(--accent); }

  .cv-list { list-style: none; display: flex; flex-direction: column; }

  .cv-item {
    display: grid;
    grid-template-columns: minmax(130px, 200px) 1fr;
    gap: var(--space-2) var(--space-8);
    padding-block: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .cv-block--navy .cv-item { border-top-color: var(--navy-line); }

  .cv-period { font-weight: 800; font-size: 18px; color: var(--accent-ink); }
  .cv-block--navy .cv-period { color: var(--accent); }

  .cv-item-title { font-weight: 800; font-size: var(--text-xl); letter-spacing: -0.02em; color: inherit; }
  .cv-item-sub { margin-top: 4px; color: var(--muted); }
  .cv-block--navy .cv-item-sub { color: var(--navy-soft); }

  .cv-bullets {
    list-style: none;
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .cv-bullets li { position: relative; padding-left: 20px; line-height: 1.6; color: var(--muted); }
  .cv-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .cv-stack { display: flex; flex-direction: column; }
  .cv-stack-row {
    display: grid;
    grid-template-columns: minmax(150px, 240px) 1fr;
    gap: var(--space-3) var(--space-8);
    padding-block: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .cv-stack-row dt { font-weight: 800; }
  .cv-stack-row dd { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; }

  .cv-pill {
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: var(--navy);
    color: var(--bg);
    font-size: var(--text-sm);
    font-weight: 600;
    transition: background 200ms ease, color 200ms ease;
  }
  .cv-pill:hover { background: var(--accent); color: var(--ink); }

  .cv-two {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(32px, 6vw, 96px);
  }
  .cv-list--compact .cv-item { grid-template-columns: 90px 1fr; gap: var(--space-5); }
  .cv-list--compact .cv-item-title { font-size: var(--text-lg); }

  .cv-langs { list-style: none; display: flex; flex-direction: column; gap: var(--space-5); }
  .cv-langs li { display: flex; flex-direction: column; gap: 2px; padding-bottom: var(--space-5); border-bottom: 1px solid var(--navy-line); }
  .cv-lang-name { font-weight: 800; font-size: var(--text-xl); }
  .cv-lang-level { color: var(--muted); }

  @media (max-width: 860px) {
    .cv-item, .cv-stack-row { grid-template-columns: 1fr; }
    .cv-two { grid-template-columns: 1fr; }
    .cv-list--compact .cv-item { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>
