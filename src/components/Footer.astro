---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { site } from '../config/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <span class="footer-copy">© {year} {t.footer.rights}</span>

    <div class="footer-links">
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="footer-link">LinkedIn</a>
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a>
      <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="footer-link">@yesa.exe</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-deep);
    color: var(--bg);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid #2C3A57;
    font-size: var(--text-sm);
  }

  .footer-copy {
    color: #B9C6DD;
  }

  .footer-links {
    display: flex;
    gap: var(--space-6);
  }

  .footer-link {
    color: #B9C6DD;
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer-link:hover {
    color: var(--bg);
  }
</style>
