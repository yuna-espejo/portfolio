---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<section class="cases">
  <div class="wrap cases-inner">

    <header class="cases-header">
      <h2 class="cases-heading">{t.home.experienceHeading}</h2>
      <a href={`/${Astro.props.lang}/experience`} class="cases-link">{t.home.experienceCta} →</a>
    </header>

    <ul class="cases-grid" role="list">
      {t.home.cases.map((c, i) => (
        <li class="case-card">
          <span class="case-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <p class="case-sector">{c.sector}</p>
          <h3 class="case-title">{c.title}</h3>
          <p class="case-summary">{c.summary}</p>
          <p class="case-result">
            <span class="result-label">{t.home.experienceResultLabel}</span>
            {c.result}
          </p>
          <ul class="case-tags" role="list">
            {c.tags.map((tag) => (
              <li class="case-tag">{tag}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .cases-inner {
    padding-block: 24px 112px;
  }

  .cases-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .cases-heading {
    font-weight: 900;
    font-size: clamp(42px, 6vw, 72px);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .cases-link {
    padding-bottom: 2px;
    border-bottom: 2px solid var(--accent);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  .cases-link:hover { color: var(--accent-ink); }

  .cases-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .case-card {
    background: var(--navy);
    color: var(--bg);
    padding: var(--space-8);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .case-index {
    font-weight: 900;
    font-size: 44px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--accent);
  }

  .case-sector {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--navy-soft);
  }

  .case-title {
    font-weight: 800;
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--bg);
  }

  .case-summary {
    color: #E3E9F5;
    line-height: 1.6;
    flex-grow: 1;
  }

  .case-result {
    padding-top: var(--space-3);
    border-top: 1px solid var(--navy-line);
    line-height: 1.55;
  }

  .result-label {
    display: block;
    margin-bottom: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent);
  }

  .case-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .case-tag {
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: var(--bg);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  @media (max-width: 1024px) {
    .cases-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 680px) {
    .cases-grid { grid-template-columns: 1fr; }
  }
</style>
